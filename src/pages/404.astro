---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Button from "../components/Button.astro";
---
<Base lang="uk" title="Сторінку не знайдено — EcoDrive" description="Такої сторінки немає. Поверніться на головну.">
  <div class="container nf">
    <Logo />
    <h1 class="nf__t">Сторінку не знайдено</h1>
    <p class="lead">Цього розділу ще немає. Поверніться на головну: там усі напрями та контакти.</p>
    <Button href="./">На головну</Button>
  </div>
</Base>
