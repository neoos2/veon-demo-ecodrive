---
import Logo from "./Logo.astro";
import FutureLink from "./FutureLink.astro";
import { PHONE, TELEGRAM, VIBER, HOURS, SOON } from "../data/site";
const nav = [
  ["#energy", "Енергонезалежність"],
  ["#transport", "Електротранспорт"],
  ["#service", "Сервіс"],
  ["#wholesale", "Опт"],
  ["#contacts", "Контакти"],
];
---
<div class="channels" data-rec="R-103,R-114">
  <div class="channels__in container">
    <a class="channels__phone" href={PHONE.tel}>{PHONE.text}</a>
    <a href={TELEGRAM} target="_blank" rel="noopener">Telegram</a>
    <a href={VIBER}>Viber</a>
    <span class="channels__hours">{HOURS}</span>
  </div>
</div>
<header class="mainbar" id="mainbar">
  <div class="mainbar__in container">
    <Logo />
    <nav class="nav" id="site-nav" aria-label="Основна навігація">
      <ul>
        {nav.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        <li class="nav__catalog"><FutureLink note={SOON} class="nav__future">Каталог</FutureLink></li>
      </ul>
    </nav>
    <a class="mainbar__phone" href={PHONE.tel}>{PHONE.text}</a>
    <a class="mainbar__call" href={PHONE.tel} aria-label="Подзвонити">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z" fill="currentColor" /></svg>
    </a>
    <button class="mainbar__menu" type="button" aria-expanded="false" aria-controls="site-nav">Меню</button>
  </div>
</header>
