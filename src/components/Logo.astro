---
// Text logo: wordmark in the display face with the brand green-teal gradient mark.
// The client's original SVG is not in the project: replace with it in FULL (decisions.md).
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<a class:list={["logo", cls]} href="#top" aria-label="ECODRIVE, на початок сторінки">
  <svg class="logo__mark" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="logo-grad" x1="4" y1="28" x2="28" y2="4" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#116C66" />
        <stop offset="1" stop-color="#7FC342" />
      </linearGradient>
    </defs>
    <circle cx="16" cy="16" r="16" fill="url(#logo-grad)" />
    <path d="M17.6 6.5 9.5 17.8h5.6l-1 7.7 8.4-11.6h-5.7z" fill="#FFFFFF" />
  </svg>
  <span class="logo__word">ECODRIVE</span>
</a>
